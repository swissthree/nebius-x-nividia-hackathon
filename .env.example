# Copy this file to `.env` and fill in your key.
# Get a key: Nebius Token Factory console → API keys → Create API key
# (the key is shown only once — save it right away).
NEBIUS_API_KEY=

# OpenAI-compatible Token Factory endpoint
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Nemotron model IDs per tier. Verify the exact IDs available to your account with:
#   python scripts/list_models.py
NEMOTRON_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Set to 1 to force mock mode even if a key is present (offline dev, saves credits)
MOCK_LLM=0

# --- Optional ---
# Let a tier "reason" before answering (1) or answer directly (0). Reasoning costs tokens and time,
# so by default only Ultra (conflict resolution) reasons.
THINKING_NANO=0
THINKING_SUPER=0
THINKING_ULTRA=1

# Cache identical model requests on disk (.cache/llm). Saves credits while developing,
# and replays recorded sample runs instantly in the deployed demo.
LLM_CACHE=0

# Estimated USD per 1M tokens, used for the cost / savings panel. Check the Token Factory pricing page.
PRICE_NANO_IN=0.06
PRICE_NANO_OUT=0.24
PRICE_SUPER_IN=0.30
PRICE_SUPER_OUT=0.90
PRICE_ULTRA_IN=1.00
PRICE_ULTRA_OUT=3.00

# Public-demo protection (0 = off)
RATE_LIMIT_PER_MINUTE=5
DAILY_RUN_CAP=300
